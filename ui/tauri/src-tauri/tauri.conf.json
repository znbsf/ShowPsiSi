{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowPsiSi \u00b7 Tauri",
  "version": "0.2.0",
  "identifier": "org.showpsisi.prototype",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShowPsiSi \u2014 Tauri / Web",
        "width": 1380,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#1E2229"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
